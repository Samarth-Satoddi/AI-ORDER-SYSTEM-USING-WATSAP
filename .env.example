# Shared database
DATABASE_URL=postgresql+psycopg://hotel:hotel@localhost:5432/hotel_orders
DJANGO_DATABASE_URL=postgresql://hotel:hotel@localhost:5432/hotel_orders
TIME_ZONE=Asia/Kolkata

# FastAPI
APP_DEBUG=0
AUTO_CREATE_TABLES=0
BACKEND_API_KEY=replace-with-a-long-random-admin-key
DASHBOARD_TOKEN=replace-with-a-long-random-dashboard-token
CORS_ORIGINS=http://localhost:5173
FASTAPI_INTERNAL_URL=http://localhost:8000
VITE_DASHBOARD_TOKEN=replace-with-the-same-dashboard-token

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-telegram-webhook-secret
TELEGRAM_HTTP_TIMEOUT_SECONDS=30

# AI extraction provider: openai, gemini, or mock for local development
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Django admin
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
